<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title + ' — ' : '' %><%= company.name %></title>
  <%
    const desc = company.tagline;
    const ogUrl = baseUrl + (typeof path !== 'undefined' ? path : '');
  %>
  <meta name="description" content="<%= desc %>">
  <link rel="icon" type="image/png" href="/img/logo.png">

  <meta property="og:type" content="website">
  <meta property="og:title" content="<%= company.name %>">
  <meta property="og:description" content="<%= desc %>">
  <meta property="og:url" content="<%= ogUrl %>">
  <meta property="og:image" content="<%= baseUrl %>/img/hero.jpg">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <div class="container nav-row">
      <a href="/" class="brand">
        <img src="/img/logo.png" alt="<%= company.name %>" class="brand-logo">
        <span class="brand-text">
          <strong>Liller Brothers</strong>
          <small>Paving &amp; Maintenance</small>
        </span>
      </a>
      <nav>
        <a href="/" class="<%= path === '/' ? 'is-active' : '' %>">Home</a>
        <a href="/services" class="<%= path === '/services' ? 'is-active' : '' %>">Services</a>
        <a href="/about" class="<%= path === '/about' ? 'is-active' : '' %>">About</a>
        <a href="/contact" class="<%= path === '/contact' ? 'is-active' : '' %>">Contact</a>
      </nav>
    </div>
  </header>
  <main>
    <% if (flash) { %>
      <div class="container">
        <div class="flash flash-<%= flash.type || 'info' %>"><%= flash.message %></div>
      </div>
    <% } %>
